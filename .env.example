# Supabase local (npm run db:start). A anon key é exibida pelo `supabase start`
# ou por `npx supabase status`.
# Para a nuvem: troque pelos valores do projeto (Settings > API).
# NUNCA coloque a service role key aqui.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key
